ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5
LEAD_WEBHOOK_URL=
STRIPE_PUBLISHABLE_KEY=pk_test_or_live_key_here
STRIPE_SECRET_KEY=sk_test_or_live_key_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
ZOOM_SCHEDULER_URL=https://scheduler.zoom.us/elijah-thornton/30-min-strategy-call
BOOKING_TIMEZONE=America/New_York
BOOKING_START_HOUR=10
BOOKING_END_HOUR=16
BOOKING_SLOT_MINUTES=30
# Optional: no calls bookable before this date (YYYY-MM-DD), e.g. time off
BOOKING_AVAILABLE_FROM=

# --- Contractor Lead System ($799 package, $275 deposit) ---
# Use sk_test_/pk_test_ keys while testing. The deposit checkout always pairs a
# publishable key of the SAME mode as STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_dashboard
# Pipeline sheet for qualified prospects + deposits (google-apps-script/lead-system-pipeline.gs).
# If blank, records go to the legacy "Leads" sheet (GOOGLE_SCRIPT_URL / built-in default).
LEAD_SYSTEM_WEBHOOK_URL=
GOOGLE_SCRIPT_URL=

# Leads from CLIENT contractor websites (google-apps-script/client-lead-tracker.gs)
CLIENT_LEADS_WEBHOOK_URL=
CLIENT_LEADS_WEBHOOK_SECRET=
# Comma-separated client IDs and the client site origins allowed to post leads
CLIENT_LEAD_ALLOWED_CLIENTS=
CLIENT_LEAD_ALLOWED_ORIGINS=

# Optional ongoing Google Ads management after the included 30 days (off by default)
LEAD_SYSTEM_MANAGEMENT_ENABLED=false
STRIPE_MANAGEMENT_PRICE_ID=
LEAD_SYSTEM_MANAGEMENT_DISPLAY_PRICE=
