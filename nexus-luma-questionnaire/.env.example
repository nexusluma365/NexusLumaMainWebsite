# Paid scheduling endpoint base. The app appends the Stripe PaymentIntent id after payment.
VITE_SALES_FUNNEL_BOOKING_URL=/api/payments/strategy/schedule
VITE_WEBSITE_BOOKING_URL=/api/payments/strategy/schedule
VITE_NEXUS_LUMA_HOME_URL=https://nexusluma.com

# Optional: real CRM/webhook endpoint for lead submission.
# Leave blank to use the built-in mock service (logs to console in dev).
VITE_LEAD_SUBMISSION_ENDPOINT=
# Optional light token checked by the Google Apps Script. This is visible in browser builds.
VITE_LEAD_SUBMISSION_SECRET=

# Stripe-backed strategy payment modal.
# The publishable key is safe for the browser; keep the secret key on the payment server only.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_BASE_URL=http://localhost:4000/api
VITE_PAYMENT_POLICY_URL=https://nexusluma.com/payment-policy
